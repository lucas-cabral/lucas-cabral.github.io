@article{cabral_o_2024,
	title = {O local do jornalismo em Florianópolis (SC):: direcionamentos de um survey para encontrar um lugar para o jornalismo},
	volume = {13},
	copyright = {Copyright (c) 2024 Lucas Santos Carmo Cabral, Gabriela Bregolin Grillo},
	issn = {2237-9967},
	shorttitle = {O local do jornalismo em {Florianópolis} ({SC})},
	url = {https://periodicos.pucminas.br/dispositiva/article/view/P.2237-9967.2024v13n24p188-201},
	pdf = {https://periodicos.pucminas.br/dispositiva/article/view/P.2237-9967.2024v13n24p188-201},
	doi = {10.5752/P.2237-9967.2024v13n24p188-201},
	abstract = {We propose a discussion on local journalism and its territories based on a partial analysis of data from a survey conducted by the [name of the research group] research group with a representative sample of the population of Florianópolis (SC). The aim is to understand the relationship between the city's inhabitants and the journalism that is produced in and for the city. We present a preliminary analysis of the motivations for news consumption, people's interest in different topics in local journalism, and what they believe should receive more attention from the media. Our objective is to understand the role of journalism in this city by mapping common interests among diverse audiences and identifying issues that can generate engagement with both the city and journalism.},
	language = {pt},
	number = {24},
	urldate = {2025-10-10},
	journal = {Dispositiva},
	author = {Cabral, Lucas Santos Carmo and Grillo, Gabriela Bregolin},
	month = dec,
	year = {2024},
	keywords = {Jornalismo Local, Comum, Lugar, Survey},
	pages = {188--201},
}

@article{kikuti-dancosky_o_2025,
	title = {O que conecta os públicos ao jornalismo local: um survey sobre interesses em Florianópolis},
	volume = {22},
	copyright = {Copyright (c) 2026 Andressa Kikuti-Dancosky, Jacques Mick, Samuel Pantoja Lima, Lucas Santos Carmo Cabral, Gabriela Bregolin Grillo, Denis Berté Sálvia, Luisa Meurer-Tavares, Dairan Mathias Paul, Daniel Cassol, Carlos V. Castilho},
	issn = {1984-6924},
	shorttitle = {O que conecta os públicos ao jornalismo local},
	url = {https://periodicos.ufsc.br/index.php/jornalismo/article/view/108302},
	pdf = {https://periodicos.ufsc.br/index.php/jornalismo/article/view/108302},
	doi = {10.5007/1984-6924.2025.e108302},
	abstract = {The article reports the results of a survey with a representative sample of the population of Florianópolis (N = 604), conducted in 2024 to assess reasons for news consumption, topics considered most interesting and those missing in coverage, habits and information sources accessed, reasons for abandoning news, alternatives for sustainability and funding from the public, and engagement in journalism. It is a methodological step from a broader study that seeks elements to establish models of social governance for local journalism, capable of developing a sense of community and shared reality (common), as an antidote to extremism. The results suggest a new way of understanding the relationship between the public and local journalism (focused on individual and social motivations, rather than media characteristics), which can be enhanced by greater attention to topics of interest. However, the data point to a scenario of low participation in journalism, especially in forms of funding.},
	language = {pt},
	urldate = {2026-08-03},
	journal = {Estudos em Jornalismo e Mídia},
	author = {Kikuti-Dancosky, Andressa and Mick, Jacques and Lima, Samuel Pantoja and Cabral, Lucas Santos Carmo and Grillo, Gabriela Bregolin and Sálvia, Denis Berté and Meurer-Tavares, Luisa and Paul, Dairan Mathias and Cassol, Daniel and Castilho, Carlos Carlos Albano Volkmer de},
	year = {2025},
	keywords = {Jornalismo a serviço dos públicos, Jornalismo local, Survey},
	pages = {1--29},
  	selected={true},
}

@article{pontes_trajetorias_2023,
	title = {Trajetórias profissionais de jornalistas fora do jornalismo no Brasil (2012-2017)},
	volume = {19},
	copyright = {Copyright (c) 2023 Cadernos da Escola de Comunicação},
	issn = {1679-3366},
	url = {https://portaldeperiodicos.unibrasil.com.br/index.php/cadernoscomunicacao/article/view/5363},
	pdf = {https://portaldeperiodicos.unibrasil.com.br/index.php/cadernoscomunicacao/article/view/5363},
	abstract = {On the basis of two online surveys made on 2012 and 2017, a longitudinal quantitative study about journalists trajectory was made, focusing on the characteristic of those who gave up the profession. The study is circumscribed at a period of crisis on both the journalism profession and Brazil, which has affected and still affects, directly or not, the journalists. Looking at the answers of 1233 journalists, it can be seen that 22\% was out of the category on 2012. This number has risen to 38\% on 2017. This article identifies, using sociodemographic and work data from the mentioned period, some of the reasons that lead journalists to get out or get kicked out from the profession.},
	language = {pt},
	urldate = {2026-08-03},
	journal = {Cadernos da Escola de Comunicação},
	author = {Pontes, Felipe Simão and Cabral, Lucas Santos Carmo},
	month = mar,
	year = {2023},
	pages = {18--31},
}

@article{cabral_financiamento_2025,
	title = {Financiamento de portais digitais nos quase desertos de notícias de Santa Catarina: análise a partir do Atlas da Notícia (2024).},
	volume = {2},
	issn = {1646-4974},
	shorttitle = {Financiamento de portais digitais nos quase desertos de notícias de Santa Catarina},
	url = {https://openurl.ebsco.com/contentitem/doi:10.25768%2F1646-4974n41v2a02?sid=ebsco:plink:crawler&id=ebsco:doi:10.25768%2F1646-4974n41v2a02},
	pdf = {https://openurl.ebsco.com/contentitem/doi:10.25768%2F1646-4974n41v2a02?sid=ebsco:plink:crawler&id=ebsco:doi:10.25768%2F1646-4974n41v2a02},
	doi = {10.25768/1646-4974n41v2a02},
	abstract = {Discover this 2025 paper in Estudos em Comunicação by Cabral, Lucas; and, Huf, Natália focusing on: Santa Catarina (Brazil : State); News websites; Journalistic reporting; Local news broadcasting; Monetization; Advertising Abstract: With the crisis in the media sector’s traditional funding models, organizations need to look for new ways to remain sustainable in a scenario in which journalism is losing its leading role as the main place to advertise to social networks and programmatic advertising. In an attempt to understand how these changes affect local journalism, we propose an analysis of the ways in which online outlets are financed in the almost news-deprived regions of the Brazilian state of Santa Catarina. Despite being the fifth state in the country with the highest number of outlets, 197 of Santa Catarina’s 295 municipalities (66.78\%) are deserts or near-deserts of news. In an exploratory research made by cross-referencing data from Atlas da Notícia v.6 (Projor, 2024), we identified 11 exclusively digital newspapers in ten cities considered almost deserted. In our analysis, we identified the use of methods such as traditional advertising, legal advertising, requests for donations and commissioned links, which contrasts with our hypothesis that, in a crisis scenario, local journalism would adopt unconventional financing strategies and provides clues about possible trends for the sustainability of outlets in places with a low density of journalistic information.},
	language = {pt-BR},
	number = {41},
	urldate = {2026-08-03},
	journal = {Estudos em Comunicação},
	author = {Cabral, Lucas and Huf, Natália},
	month = dec,
	year = {2025},
	pages = {18},
}

